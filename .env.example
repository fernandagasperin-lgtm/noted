# ---- Banco de dados (obrigatorio) ----
# Connection string do Postgres. No Supabase: Project Settings -> Database.
# Se a conexao direta falhar na hospedagem, use a string do "Session pooler".
DATABASE_URL=

# ---- Sessao (obrigatorio) ----
# String aleatoria e longa, assina o cookie de login.
#   Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela o app recusa todo acesso. As contas ficam no banco: a primeira pessoa
# a abrir o app cria a conta de administrador.
APP_SECRET=

# ---- Imagens (opcional) ----
# Supabase Storage. Sem isto, tudo funciona menos enviar imagem.
# A service role key e secreta: nunca vai para o navegador nem para o git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Geracao com Claude (opcional) ----
# Sem esta chave o card de assistente monta o prompt para voce copiar,
# em vez de gerar sozinho.  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
