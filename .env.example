# ---- Banco de dados (obrigatorio) ----
# Na Vercel isso e preenchido sozinho ao conectar o banco Neon.
# Para rodar local apontando para o banco da nuvem, copie a connection string
# do painel do Neon para ca.
DATABASE_URL=

# ---- Sessao (obrigatorio) ----
# String aleatoria e longa, usada para assinar o cookie de login.
#   Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela o app recusa todo acesso. As contas em si ficam no banco: a primeira
# pessoa a abrir o app cria a conta de administrador.
APP_SECRET=

# ---- Imagens (obrigatorio na Vercel) ----
# Vem sozinho ao criar um Blob store na Vercel.
BLOB_READ_WRITE_TOKEN=

# ---- Geracao com Claude (opcional) ----
# Sem esta chave o card de assistente monta o prompt para voce copiar,
# em vez de gerar sozinho.  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
